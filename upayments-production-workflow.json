{
    "name": "UPayments Production Workflow",
    "nodes": [
        {
            "name": "Create Payment",
            "type": "n8n-nodes-base.upayments",
            "parameters": {
                "action": "createPayment",
                "environment": "https://api.upayments.com/api/"
            }
        },
        {
            "name": "Verify Payment",
            "type": "n8n-nodes-base.upayments",
            "parameters": {
                "action": "verifyPayment",
                "environment": "https://api.upayments.com/api/"
            }
        },
        {
            "name": "Get Status",
            "type": "n8n-nodes-base.upayments",
            "parameters": {
                "action": "getStatus",
                "environment": "https://api.upayments.com/api/"
            }
        }
    ]
}